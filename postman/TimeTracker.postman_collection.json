{
  "info": {
    "name": "Time Tracker — complete API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "project_id",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "time_entry_id",
      "value": ""
    },
    {
      "key": "manual_start",
      "value": ""
    },
    {
      "key": "manual_end",
      "value": ""
    },
    {
      "key": "report_from",
      "value": ""
    },
    {
      "key": "report_to",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "2. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Олеся\",\n  \"email\": \"olesya@example.com\",\n  \"password\": \"my-password-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set(\"access_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"olesya@example.com\",\n  \"password\": \"my-password-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set(\"access_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "5. Create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/projects",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Учебный проект\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set(\"project_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. List projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/projects",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "7. Get project",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/projects/{{project_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "8. Update project",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/projects/{{project_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Новое название\",\n  \"is_completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/projects/{{project_id}}/tasks",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Учебная задача\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"task_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. List tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/projects/{{project_id}}/tasks",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. Get task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/tasks/{{task_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Timer, history and reports",
      "description": "Выполнить после создания задачи. После сценария останутся интервалы таймера: удаление задачи вернёт 409 до удаления этих записей. Повторное создание ручного интервала допускается при отсутствии пересечений.",
      "item": [
        {
          "name": "Start (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries/start",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Active (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/time-entries/active",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Pause (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries/pause",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resume (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries/resume",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Stop (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries/stop",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "History (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/time-entries?project_id={{project_id}}&limit=100&offset=0",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Manual entry (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"started_at\": \"{{manual_start}}\",\n  \"ended_at\": \"{{manual_end}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"time_entry_id\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = new Date(Date.now() - 2 * 86400000);",
                  "const start = new Date(end.getTime() - 3600000);",
                  "pm.collectionVariables.set(\"manual_start\", start.toISOString());",
                  "pm.collectionVariables.set(\"manual_end\", end.toISOString());"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit manual entry (200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/time-entries/{{time_entry_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"started_at\": \"{{manual_start}}\",\n  \"ended_at\": \"{{manual_end}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Report by project",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reports?from={{report_from}}&to={{report_to}}&group_by=project&project_id={{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const msk = new Date(Date.now() + 3 * 3600000);",
                  "pm.collectionVariables.set(\"report_to\", msk.toISOString().slice(0, 10));",
                  "msk.setUTCDate(msk.getUTCDate() - 7);",
                  "pm.collectionVariables.set(\"report_from\", msk.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report by task",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reports?from={{report_from}}&to={{report_to}}&group_by=task&project_id={{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const msk = new Date(Date.now() + 3 * 3600000);",
                  "pm.collectionVariables.set(\"report_to\", msk.toISOString().slice(0, 10));",
                  "msk.setUTCDate(msk.getUTCDate() - 7);",
                  "pm.collectionVariables.set(\"report_from\", msk.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report by day",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reports?from={{report_from}}&to={{report_to}}&group_by=day&project_id={{project_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const msk = new Date(Date.now() + 3 * 3600000);",
                  "pm.collectionVariables.set(\"report_to\", msk.toISOString().slice(0, 10));",
                  "msk.setUTCDate(msk.getUTCDate() - 7);",
                  "pm.collectionVariables.set(\"report_from\", msk.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete manual entry (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/time-entries/{{time_entry_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "12. Update task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/tasks/{{task_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Новое название задачи\",\n  \"is_completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13. Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/tasks/{{task_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "14. Delete project",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/projects/{{project_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
