POSTGRES_DB=timetracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change_me_local_only
# Эти адрес и порт нужны для локального API. Docker API использует db:5432.
DB_HOST=127.0.0.1
DB_PORT=5432
BACKEND_HOST=127.0.0.1
# Также внешний порт Docker API на компьютере.
BACKEND_PORT=8080
# HS256 поддерживается явно; алгоритм из JWT-заголовка не выбирает проверку.
ALGORITHM=HS256
TOKEN_EXPIRE_HOURS=1
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
